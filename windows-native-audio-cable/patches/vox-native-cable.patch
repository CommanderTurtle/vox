diff --git a/audio/sysvad/EndpointsCommon/voxcable.cpp b/audio/sysvad/EndpointsCommon/voxcable.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..969a9799695aa58d2670a002619747b36ef833e0
--- /dev/null
+++ b/audio/sysvad/EndpointsCommon/voxcable.cpp
@@ -0,0 +1,140 @@
+#include "voxcable.h"
+
+// 100 ms of canonical 48 kHz, stereo, signed 16-bit PCM. Overflow drops the
+// oldest samples so live audio remains live; underrun is explicit silence.
+#define VOX_CABLE_BUFFER_BYTES \
+    (VOX_CABLE_SAMPLE_RATE * VOX_CABLE_BYTES_PER_FRAME / 10)
+#define VOX_CABLE_POOL_TAG 'CxoV'
+
+static UCHAR*     g_VoxCableBuffer = nullptr;
+static ULONG      g_VoxCableReadOffset = 0;
+static ULONG      g_VoxCableWriteOffset = 0;
+static ULONG      g_VoxCableAvailable = 0;
+static KSPIN_LOCK g_VoxCableLock;
+
+_IRQL_requires_max_(PASSIVE_LEVEL)
+NTSTATUS VoxCableInitialize()
+{
+    if (g_VoxCableBuffer != nullptr)
+    {
+        return STATUS_SUCCESS;
+    }
+
+    KeInitializeSpinLock(&g_VoxCableLock);
+    g_VoxCableBuffer = static_cast<UCHAR*>(ExAllocatePool2(
+        POOL_FLAG_NON_PAGED,
+        VOX_CABLE_BUFFER_BYTES,
+        VOX_CABLE_POOL_TAG));
+
+    if (g_VoxCableBuffer == nullptr)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    RtlZeroMemory(g_VoxCableBuffer, VOX_CABLE_BUFFER_BYTES);
+    g_VoxCableReadOffset = 0;
+    g_VoxCableWriteOffset = 0;
+    g_VoxCableAvailable = 0;
+    return STATUS_SUCCESS;
+}
+
+_IRQL_requires_max_(PASSIVE_LEVEL)
+VOID VoxCableShutdown()
+{
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&g_VoxCableLock, &oldIrql);
+    UCHAR* buffer = g_VoxCableBuffer;
+    g_VoxCableBuffer = nullptr;
+    g_VoxCableReadOffset = 0;
+    g_VoxCableWriteOffset = 0;
+    g_VoxCableAvailable = 0;
+    KeReleaseSpinLock(&g_VoxCableLock, oldIrql);
+
+    if (buffer != nullptr)
+    {
+        ExFreePoolWithTag(buffer, VOX_CABLE_POOL_TAG);
+    }
+}
+
+_IRQL_requires_max_(DISPATCH_LEVEL)
+VOID VoxCableWrite(_In_reads_bytes_(ByteCount) const UCHAR* Source, _In_ ULONG ByteCount)
+{
+    if (Source == nullptr || ByteCount == 0)
+    {
+        return;
+    }
+
+    // If a single write exceeds capacity, retain only its newest audio.
+    if (ByteCount >= VOX_CABLE_BUFFER_BYTES)
+    {
+        Source += ByteCount - VOX_CABLE_BUFFER_BYTES;
+        ByteCount = VOX_CABLE_BUFFER_BYTES;
+    }
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&g_VoxCableLock, &oldIrql);
+    if (g_VoxCableBuffer == nullptr)
+    {
+        KeReleaseSpinLock(&g_VoxCableLock, oldIrql);
+        return;
+    }
+
+    const ULONG overflow =
+        (g_VoxCableAvailable + ByteCount > VOX_CABLE_BUFFER_BYTES)
+            ? (g_VoxCableAvailable + ByteCount - VOX_CABLE_BUFFER_BYTES)
+            : 0;
+    if (overflow > 0)
+    {
+        g_VoxCableReadOffset =
+            (g_VoxCableReadOffset + overflow) % VOX_CABLE_BUFFER_BYTES;
+        g_VoxCableAvailable -= overflow;
+    }
+
+    const ULONG first = min(ByteCount, VOX_CABLE_BUFFER_BYTES - g_VoxCableWriteOffset);
+    RtlCopyMemory(g_VoxCableBuffer + g_VoxCableWriteOffset, Source, first);
+    if (ByteCount > first)
+    {
+        RtlCopyMemory(g_VoxCableBuffer, Source + first, ByteCount - first);
+    }
+
+    g_VoxCableWriteOffset =
+        (g_VoxCableWriteOffset + ByteCount) % VOX_CABLE_BUFFER_BYTES;
+    g_VoxCableAvailable += ByteCount;
+    KeReleaseSpinLock(&g_VoxCableLock, oldIrql);
+}
+
+_IRQL_requires_max_(DISPATCH_LEVEL)
+VOID VoxCableRead(_Out_writes_bytes_(ByteCount) UCHAR* Destination, _In_ ULONG ByteCount)
+{
+    if (Destination == nullptr || ByteCount == 0)
+    {
+        return;
+    }
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&g_VoxCableLock, &oldIrql);
+    if (g_VoxCableBuffer == nullptr)
+    {
+        KeReleaseSpinLock(&g_VoxCableLock, oldIrql);
+        RtlZeroMemory(Destination, ByteCount);
+        return;
+    }
+
+    const ULONG available = min(ByteCount, g_VoxCableAvailable);
+    const ULONG first = min(available, VOX_CABLE_BUFFER_BYTES - g_VoxCableReadOffset);
+    RtlCopyMemory(Destination, g_VoxCableBuffer + g_VoxCableReadOffset, first);
+    if (available > first)
+    {
+        RtlCopyMemory(Destination + first, g_VoxCableBuffer, available - first);
+    }
+
+    g_VoxCableReadOffset =
+        (g_VoxCableReadOffset + available) % VOX_CABLE_BUFFER_BYTES;
+    g_VoxCableAvailable -= available;
+    KeReleaseSpinLock(&g_VoxCableLock, oldIrql);
+
+    if (available < ByteCount)
+    {
+        RtlZeroMemory(Destination + available, ByteCount - available);
+    }
+}
diff --git a/audio/sysvad/EndpointsCommon/voxcable.h b/audio/sysvad/EndpointsCommon/voxcable.h
new file mode 100644
index 0000000000000000000000000000000000000000..91c08259382d409da1d22a300b617f9361f58e38
--- /dev/null
+++ b/audio/sysvad/EndpointsCommon/voxcable.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <ntddk.h>
+
+// The Windows Audio Engine performs any application-side conversion. Both
+// Vox endpoints expose this one shared format to keep the kernel bridge a
+// deterministic byte-for-byte PCM transport.
+#define VOX_CABLE_SAMPLE_RATE       48000
+#define VOX_CABLE_CHANNELS          2
+#define VOX_CABLE_BITS_PER_SAMPLE   16
+#define VOX_CABLE_BYTES_PER_FRAME   4
+
+_IRQL_requires_max_(PASSIVE_LEVEL)
+NTSTATUS VoxCableInitialize();
+
+_IRQL_requires_max_(PASSIVE_LEVEL)
+VOID VoxCableShutdown();
+
+_IRQL_requires_max_(DISPATCH_LEVEL)
+VOID VoxCableWrite(_In_reads_bytes_(ByteCount) const UCHAR* Source, _In_ ULONG ByteCount);
+
+_IRQL_requires_max_(DISPATCH_LEVEL)
+VOID VoxCableRead(_Out_writes_bytes_(ByteCount) UCHAR* Destination, _In_ ULONG ByteCount);
